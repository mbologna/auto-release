#!/bin/sh
# auto-release: tag the next semantic version and publish a forge Release with
# grouped notes, without a release pull request. Runs the same way on GitHub
# Actions, GitLab CI and Forgejo Actions; see README.md.
#
#   auto-release plan       print the next version and its notes, change nothing
#   auto-release release    plan, then push the tag and create the Release
#
# Configuration comes from the environment (CI jobs set it from their inputs):
#   AUTO_RELEASE_STRATEGY            commits (default) | conventional | security
#   AUTO_RELEASE_IMAGE               image the fresh rebuild scans (GitLab: $CI_REGISTRY_IMAGE)
#   AUTO_RELEASE_IMAGES              several images the fresh rebuild scans instead, as
#                                    IMAGE=DOCKERFILE entries separated by spaces or
#                                    commas (=DOCKERFILE defaults to =Dockerfile)
#   AUTO_RELEASE_DOCKERFILES         security: Dockerfiles whose base image to compare,
#                                    separated by spaces or commas (default Dockerfile)
#   AUTO_RELEASE_REBUILD_DAYS        commits, conventional, security: release a fresh
#                                    rebuild when the last release is this many days old
#                                    and its image has fixable findings its base lacks
#                                    (default 7; 0 disables)
#   AUTO_RELEASE_MAINTENANCE_DAYS    conventional: release a patch when runtime inputs
#                                    changed and the last release is this many days old,
#                                    even without a feat or fix commit (default 7; 0
#                                    disables)
#   AUTO_RELEASE_MINUTES_BUDGET_PCT  GitLab: when the namespace's CI minutes, projected to
#                                    the month's end, exceed this share of the quota, the
#                                    maintenance release waits the longer period below
#                                    (default 85; 0 disables; needs CI_MINUTES_TOKEN)
#   AUTO_RELEASE_MAINTENANCE_DAYS_OVER_BUDGET
#                                    the longer period (default 28)
#   AUTO_RELEASE_MINUTES_QUOTA       the namespace's monthly CI minutes (default 400)
#   CI_MINUTES_TOKEN                 GitLab token with read_api that reads the usage
#   AUTO_RELEASE_RUNTIME_PATHS       the runtime inputs: shell patterns separated by spaces
#                                    or commas; one without a / matches a file name in any
#                                    directory (default Dockerfile* uv.lock
#                                    requirements*.txt pyproject.toml package.json
#                                    package-lock.json go.mod go.sum composer.*)
#   AUTO_RELEASE_BASE_IMAGE_PATTERN  egrep pattern; matching Dockerfile lines go into the notes
#   AUTO_RELEASE_TOKEN               token that pushes the tag and creates the Release
#                                    (GitHub/Forgejo fall back to GITHUB_TOKEN)
#   AUTO_RELEASE_DISPATCH            false: do not start the tag build (GitHub/Forgejo)
#   AUTO_RELEASE_DISPATCH_WORKFLOW   workflow file to start on the tag (GitHub defaults
#                                    to the caller of the running workflow)
#   AUTO_RELEASE_CONFIG              git-cliff config (default ./cliff.toml, else bundled)
#   AUTO_RELEASE_METADATA_CMD        shell command printing SemVer build metadata for the
#                                    tag, e.g. the pinned upstream version (up2.15.3 ->
#                                    v1.4.0+up2.15.3); a change in it releases a patch
#   AUTO_RELEASE_FORGE               github | gitlab | forgejo | none (default: detected)
#   AUTO_RELEASE_DRY_RUN             true: same as the plan command
set -eu

# vX.Y.Z with optional build metadata (v1.4.0+up2.15.3).
TAG_PATTERN='^v[0-9]+\.[0-9]+\.[0-9]+(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'
SHARE_DIR=${AUTO_RELEASE_SHARE_DIR:-$(cd "$(dirname "$0")/../share/auto-release" && pwd)}

log() { printf '%s\n' "$*" >&2; }
die() { log "auto-release: $*"; exit 1; }

usage() {
	sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//;p;}' "$0"
	exit "${1:-0}"
}

is_true() { case ${1:-} in true | 1 | yes) return 0 ;; *) return 1 ;; esac; }

# Calls a forge API. curl's --fail-with-body keeps the error body, which says
# why (missing scope, tag already released) far better than the status code.
api() {
	method=$1 url=$2 auth=$3 body=${4:-}
	if [ -n "$body" ]; then
		printf '%s' "$body" | curl -sS --fail-with-body --retry 3 -X "$method" \
			-H "$auth" -H 'Content-Type: application/json' -H 'Accept: application/json' \
			--data @- "$url"
	else
		curl -sS --fail-with-body --retry 3 -X "$method" -H "$auth" -H 'Accept: application/json' "$url"
	fi
}

# --- forge adapters ----------------------------------------------------------
# Each forge sets: FORGE_TOKEN, PUSH_URL, COMMIT_URL, COMPARE_URL (prefixes) and
# implements forge_release TAG NOTES_FILE and forge_dispatch TAG.

detect_forge() {
	if [ -n "${AUTO_RELEASE_FORGE:-}" ]; then
		printf '%s' "$AUTO_RELEASE_FORGE"
	elif is_true "${FORGEJO_ACTIONS:-}" || is_true "${GITEA_ACTIONS:-}"; then
		# Before GITHUB_ACTIONS: Forgejo's runner sets that too.
		printf forgejo
	elif is_true "${GITHUB_ACTIONS:-}"; then
		printf github
	elif is_true "${GITLAB_CI:-}"; then
		printf gitlab
	else
		printf none
	fi
}

# Host part of a URL, for an authenticated push URL.
url_host() { printf '%s' "$1" | sed -E 's|^[a-z]+://||; s|/.*$||'; }

setup_github() {
	FORGE_TOKEN=${AUTO_RELEASE_TOKEN:-${GITHUB_TOKEN:-}}
	server=${GITHUB_SERVER_URL:-https://github.com}
	repo=${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}
	FORGE_API=${GITHUB_API_URL:-https://api.github.com}
	PUSH_URL="https://x-access-token:${FORGE_TOKEN}@$(url_host "$server")/${repo}.git"
	COMMIT_URL="${server}/${repo}/commit/"
	COMPARE_URL="${server}/${repo}/compare/"
	REGISTRY_LOGIN="ghcr.io x-access-token"
}

setup_forgejo() {
	FORGE_TOKEN=${AUTO_RELEASE_TOKEN:-${GITHUB_TOKEN:-}}
	server=${GITHUB_SERVER_URL:?GITHUB_SERVER_URL is not set}
	repo=${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}
	FORGE_API="${server}/api/v1"
	PUSH_URL="https://x-access-token:${FORGE_TOKEN}@$(url_host "$server")/${repo}.git"
	COMMIT_URL="${server}/${repo}/commit/"
	COMPARE_URL="${server}/${repo}/compare/"
	REGISTRY_LOGIN="$(url_host "$server") x-access-token"
}

setup_gitlab() {
	FORGE_TOKEN=${AUTO_RELEASE_TOKEN:-}
	FORGE_API=${CI_API_V4_URL:?CI_API_V4_URL is not set}
	PUSH_URL="${CI_SERVER_PROTOCOL:-https}://oauth2:${FORGE_TOKEN}@${CI_SERVER_FQDN:-${CI_SERVER_HOST:?}}/${CI_PROJECT_PATH:?}.git"
	COMMIT_URL="${CI_PROJECT_URL:?}/-/commit/"
	COMPARE_URL="${CI_PROJECT_URL}/-/compare/"
	AUTO_RELEASE_IMAGE=${AUTO_RELEASE_IMAGE:-${CI_REGISTRY_IMAGE:-}}
	REGISTRY_LOGIN=""
	# The job token reads the project's own registry; no API scope needed.
	if [ -n "${CI_REGISTRY:-}" ] && [ -n "${CI_JOB_TOKEN:-}" ]; then
		REGISTRY_LOGIN="$CI_REGISTRY gitlab-ci-token"
		REGISTRY_PASSWORD=$CI_JOB_TOKEN
	fi
}

setup_none() {
	FORGE_TOKEN="" PUSH_URL="" COMMIT_URL="" COMPARE_URL="" REGISTRY_LOGIN=""
}

release_json() {
	jq -cn --arg tag "$1" --rawfile body "$2" \
		'{tag_name: $tag, name: $tag, body: $body, draft: false, prerelease: false}'
}

forge_release() {
	case $FORGE in
	github)
		api POST "${FORGE_API}/repos/${GITHUB_REPOSITORY}/releases" \
			"Authorization: Bearer ${FORGE_TOKEN}" "$(release_json "$1" "$2")" >/dev/null
		;;
	forgejo)
		api POST "${FORGE_API}/repos/${GITHUB_REPOSITORY}/releases" \
			"Authorization: token ${FORGE_TOKEN}" "$(release_json "$1" "$2")" >/dev/null
		;;
	gitlab)
		api POST "${FORGE_API}/projects/${CI_PROJECT_ID:?}/releases" \
			"PRIVATE-TOKEN: ${FORGE_TOKEN}" \
			"$(jq -cn --arg tag "$1" --rawfile body "$2" '{tag_name: $tag, name: $tag, description: $body}')" >/dev/null
		;;
	esac
}

# The workflow file to start on the new tag. In a reusable GitHub workflow
# GITHUB_WORKFLOW_REF names the caller: owner/repo/.github/workflows/ci.yml@ref.
dispatch_workflow() {
	wf=${AUTO_RELEASE_DISPATCH_WORKFLOW:-${GITHUB_WORKFLOW_REF:-}}
	wf=${wf%@*}
	printf '%s' "${wf##*/}"
}

# A tag pushed with GitHub's GITHUB_TOKEN starts no workflow run (Forgejo's
# automatic token behaves the same), so start the tag build explicitly;
# workflow_dispatch is the one event those tokens may trigger. GitLab needs
# nothing: a tag pushed with a personal or project token runs a pipeline.
forge_dispatch() {
	is_true "${AUTO_RELEASE_DISPATCH:-true}" || return 0
	case $FORGE in github | forgejo) ;; *) return 0 ;; esac
	wf=$(dispatch_workflow)
	if [ -z "$wf" ]; then
		log "No workflow to dispatch on $1 (set AUTO_RELEASE_DISPATCH_WORKFLOW); skipping."
		return 0
	fi
	if [ "$FORGE" = github ]; then
		auth="Authorization: Bearer ${FORGE_TOKEN}"
	else
		auth="Authorization: token ${FORGE_TOKEN}"
	fi
	api POST "${FORGE_API}/repos/${GITHUB_REPOSITORY}/actions/workflows/${wf}/dispatches" \
		"$auth" "$(jq -cn --arg ref "$1" '{ref: $ref}')" >/dev/null
	log "Dispatched ${wf} on $1"
}

# --- planning ----------------------------------------------------------------

latest_tag() {
	git tag --list 'v*.*.*' --sort=-version:refname | grep -E "$TAG_PATTERN" | head -n 1 || true
}

# Runs a configured command (NAME CMD REGEX) in the checkout and prints its
# output, which must be one line matching REGEX.
command_value() {
	out=$(sh -c "$2") || die "$1 failed: $2"
	if [ "$(printf '%s\n' "$out" | wc -l)" -ne 1 ] || ! printf '%s' "$out" | grep -qE "$3"; then
		die "$1 printed '$out', which does not match $3"
	fi
	printf '%s' "$out"
}

# The image tag a release tag publishes: OCI tags have no +, so build metadata
# is dropped (v1.4.0+up2.15.3 -> 1.4.0).
image_tag() {
	t=${1#v}
	printf '%s' "${t%%+*}"
}

bump() { # VERSION(without v) KIND
	major=${1%%.*} rest=${1#*.}
	minor=${rest%%.*} patch=${rest#*.}
	case $2 in
	major) printf 'v%s.0.0' "$((major + 1))" ;;
	minor) printf 'v%s.%s.0' "$major" "$((minor + 1))" ;;
	patch) printf 'v%s.%s.%s' "$major" "$minor" "$((patch + 1))" ;;
	esac
}

# version_above A B: whether version A (X.Y.Z, without v) is above B.
version_above() {
	awk -v a="$1" -v b="$2" 'BEGIN {
		split(a, x, "."); split(b, y, ".")
		for (i = 1; i <= 3; i++) if (x[i] + 0 != y[i] + 0) exit !(x[i] + 0 > y[i] + 0)
		exit 1
	}'
}

# conventional: only commits that change the version for a user count, the same
# set release-please releases for. docs/chore/ci/test/refactor alone do not.
has_releasable_commits() {
	git log "$1..HEAD" --no-merges --format='%s%n%b' |
		grep -qE '^(feat|fix|perf|revert)(\([^)]*\))?!?:|^[a-zA-Z]+(\([^)]*\))?!:|^BREAKING[ -]CHANGE:'
}

# security: a CVE fix commit since the last tag. Only fix(security), the type
# Renovate gives its vulnerability updates: a chore(security) or build(security)
# commit (a dev-only dependency, say) changes nothing users run.
has_security_commits() {
	git log "$1..HEAD" --no-merges --format='%s' | grep -qE '^fix\(security\)!?:'
}

# Fixable HIGH/CRITICAL findings of an image as sorted "CVE package" lines,
# the same filter image-cve-alert reports with. A .trivyignore in the checkout
# applies (trivy reads it by default). With a second argument "os", only the
# distribution's packages (apk, apt) count. Fails when the image cannot be
# scanned.
image_vulns() {
	json=$(trivy image --quiet --image-src remote --scanners vuln --ignore-unfixed \
		--severity "${AUTO_RELEASE_SEVERITY:-HIGH,CRITICAL}" --format json "$1") || return 1
	printf '%s' "$json" | jq -r --arg only "${2:-}" '.Results[]? |
		select($only != "os" or .Class == "os-pkgs") |
		.Vulnerabilities[]? | "\(.VulnerabilityID) \(.PkgName)"' | sort -u
}

# The Dockerfiles whose base image the security strategy compares:
# AUTO_RELEASE_DOCKERFILES with commas turned into spaces, for word splitting.
dockerfiles() {
	printf '%s\n' "${AUTO_RELEASE_DOCKERFILES:-Dockerfile}" | tr ',' ' '
}

# Reads a Dockerfile on stdin and prints the base image of its final stage:
# the last FROM, with --platform and other flags dropped, ${VAR}, ${VAR:-x}
# and $VAR taken from the ARG defaults before the first FROM (the only ones a
# FROM can use), and a FROM of an earlier stage followed to that stage's
# image. Prints nothing for scratch, or a Dockerfile without FROM; fails when a
# variable has no value, since then the image depends on a --build-arg.
dockerfile_base() {
	awk '
	function expand(s,   out, tok, i, def) {
		out = ""
		while (match(s, /\$\{[A-Za-z_][A-Za-z0-9_]*(:-[^}]*)?\}|\$[A-Za-z_][A-Za-z0-9_]*/)) {
			tok = substr(s, RSTART, RLENGTH)
			out = out substr(s, 1, RSTART - 1)
			s = substr(s, RSTART + RLENGTH)
			if (substr(tok, 2, 1) == "{") tok = substr(tok, 3, length(tok) - 3)
			else tok = substr(tok, 2)
			def = ""
			if ((i = index(tok, ":-")) > 0) {
				def = substr(tok, i + 2)
				tok = substr(tok, 1, i - 1)
			}
			if (args[tok] != "") out = out args[tok]
			else if (def != "") out = out def
			else unresolved = 1
		}
		return out s
	}
	function unquote(v,   c) {
		c = substr(v, 1, 1)
		if (length(v) > 1 && (c == "\"" || c == sq) && substr(v, length(v)) == c) v = substr(v, 2, length(v) - 2)
		return v
	}
	BEGIN { sq = sprintf("%c", 39) }
	{ sub(/\r$/, "") }
	/^[ \t]*#/ { next }
	/\\$/ { buf = buf substr($0, 1, length($0) - 1) " "; next }
	{
		line = buf $0
		buf = ""
		n = split(line, f, /[ \t]+/)
		k = (f[1] == "") ? 2 : 1
		instr = toupper(f[k])
		if (instr == "ARG" && stages == 0) {
			for (j = k + 1; j <= n; j++) {
				if (f[j] == "") continue
				if ((e = index(f[j], "=")) > 0) args[substr(f[j], 1, e - 1)] = unquote(substr(f[j], e + 1))
			}
		} else if (instr == "FROM") {
			j = k + 1
			while (j <= n && f[j] ~ /^--/) j++
			stages++
			image[stages] = f[j]
			name[stages] = (toupper(f[j + 1]) == "AS") ? tolower(f[j + 2]) : ""
		}
	}
	END {
		if (stages == 0) exit 0
		i = stages
		ref = expand(image[i])
		for (j = i - 1; j >= 1; j--) {
			if (name[j] != "" && name[j] == tolower(ref)) ref = expand(image[j])
		}
		if (unresolved) exit 1
		if (tolower(ref) != "scratch") print ref
	}'
}

# security: the base image of a Dockerfile's final stage changed since the last
# version (a Renovate tag or digest update, usually), and the new one no
# longer has fixable HIGH/CRITICAL findings that the old one has. Nothing is
# built: both are public or registry images, scanned remotely. Sets
# SECURITY_NOTE to the list. A Dockerfile that cannot be read, resolved or
# scanned is skipped with a warning, never failing the run.
base_image_fixes_cves() {
	all_fixed=""
	for df in $(dockerfiles); do
		df=${df#./}
		git cat-file -e "HEAD:./$df" 2>/dev/null || continue
		if ! git cat-file -e "$1:./$df" 2>/dev/null; then
			log "$df is new since $1: no base image to compare"
			continue
		fi
		if ! old=$(git show "$1:./$df" | dockerfile_base) ||
			! new=$(git show "HEAD:./$df" | dockerfile_base); then
			log "warning: cannot resolve the base image of $df (an ARG without a default?); skipping it"
			continue
		fi
		if [ "$old" = "$new" ]; then
			log "Base image of $df unchanged since $1: ${new:-none}"
			continue
		fi
		log "Base image of $df: ${old:-none} in $1, ${new:-none} now"
		if [ -z "$old" ] || [ -z "$new" ]; then
			continue
		fi
		registry_login
		if ! released=$(image_vulns "$old"); then
			log "warning: cannot scan $old; skipping $df"
			continue
		fi
		if ! current=$(image_vulns "$new"); then
			log "warning: cannot scan $new; skipping $df"
			continue
		fi
		fixed=$(printf '%s\n' "$released" | grep -vxF -f "$(printf '%s\n' "$current" | tmpfile)" | grep . || true)
		log "Fixable HIGH/CRITICAL in $old: $(printf '%s' "$released" | grep -c . || true), in $new: $(printf '%s' "$current" | grep -c . || true)"
		[ -z "$fixed" ] || all_fixed=$(printf '%s\n%s' "$all_fixed" "$fixed")
	done
	[ -n "$all_fixed" ] || return 1
	SECURITY_NOTE=$(printf '%s\n' "$all_fixed" | grep . | sort -u | awk '{printf "- %s in `%s`\n", $1, $2}')
}

# A variable holding a number of days, as a plain number: whole_days NAME DEFAULT.
whole_days() {
	eval "d=\${$1:-$2}"
	case $d in *[!0-9]*) die "$1 must be a whole number of days, 0 to disable; got '$d'" ;; esac
	d=$(printf '%s' "$d" | sed 's/^0*//')
	printf '%s' "${d:-0}"
}

# AUTO_RELEASE_REBUILD_DAYS as a plain number; 7 when unset or empty.
rebuild_days() { whole_days AUTO_RELEASE_REBUILD_DAYS 7; }

# AUTO_RELEASE_MAINTENANCE_DAYS as a plain number; 7 when unset or empty.
maintenance_days() { whole_days AUTO_RELEASE_MAINTENANCE_DAYS 7; }

# A whole number, or 0 when unset or empty: whole_number NAME DEFAULT.
whole_number() {
	eval "n=\${$1:-$2}"
	case $n in "" | *[!0-9]*) die "$1 must be a whole number; got '$n'" ;; esac
	n=$(printf '%s' "$n" | sed 's/^0*//')
	printf '%s' "${n:-0}"
}

# Days in a month: days_in_month YEAR MONTH (no leading zeros).
days_in_month() {
	case $2 in
	1 | 3 | 5 | 7 | 8 | 10 | 12) printf 31 ;;
	4 | 6 | 9 | 11) printf 30 ;;
	*)
		if [ $(($1 % 4)) -eq 0 ] && { [ $(($1 % 100)) -ne 0 ] || [ $(($1 % 400)) -eq 0 ]; }; then
			printf 29
		else
			printf 28
		fi
		;;
	esac
}

# Month-end CI minutes as a percentage of the quota, projected linearly from
# the minutes used by day DAY of a month of DAYS days:
# projected_pct USED DAY DAYS QUOTA.
projected_pct() {
	printf '%s' $(($1 * $3 * 100 / ($2 * $4)))
}

# GitLab only: true when the namespace's CI minutes, projected to the end of
# the month, exceed AUTO_RELEASE_MINUTES_BUDGET_PCT of
# AUTO_RELEASE_MINUTES_QUOTA. Reads ciMinutesUsage (GraphQL) for the
# namespace of CI_MINUTES_TOKEN's user. False, saying why, when the check is
# off, the token is missing or the query fails: the shorter period applies.
minutes_over_budget() {
	budget=$(whole_number AUTO_RELEASE_MINUTES_BUDGET_PCT 85)
	quota=$(whole_number AUTO_RELEASE_MINUTES_QUOTA 400)
	if [ "$budget" -eq 0 ] || [ "$quota" -eq 0 ]; then
		log "CI minutes check: off"
		return 1
	fi
	if [ -z "${CI_MINUTES_TOKEN:-}" ]; then
		log "CI minutes check: no CI_MINUTES_TOKEN (a read_api token), so the usage is unknown; keeping $days days"
		return 1
	fi
	# AUTO_RELEASE_TODAY (YYYY-MM-DD) lets the tests pick the day.
	today=${AUTO_RELEASE_TODAY:-$(date -u +%Y-%m-%d)}
	case $today in [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]) ;; *) die "AUTO_RELEASE_TODAY must be YYYY-MM-DD; got '$today'" ;; esac
	year=${today%%-*} month=${today#*-} day=${today##*-}
	month=${month%-*}
	month=${month#0} day=${day#0}
	url=${CI_API_GRAPHQL_URL:-${CI_SERVER_URL:-https://gitlab.com}/api/graphql}
	first=$(printf '%s-%02d-01' "$year" "$month")
	query=$(jq -cn --arg d "$first" \
		'{query: ("query { ciMinutesUsage(date: \"" + $d + "\") { nodes { monthIso8601 minutes } } }")}')
	if ! json=$(printf '%s' "$query" | curl -sS --fail-with-body --retry 2 --max-time 30 -X POST \
		-H "Authorization: Bearer ${CI_MINUTES_TOKEN}" -H 'Content-Type: application/json' \
		--data @- "$url" 2>&1) ||
		! used=$(printf '%s' "$json" | jq -er --arg d "$first" \
			'if .errors then error(.errors[0].message) else .data.ciMinutesUsage.nodes |
			(map(select(.monthIso8601 == $d)) | first | .minutes) // 0 end' 2>&1); then
		log "CI minutes check: the usage query failed, keeping $days days: $(printf '%s' "${used:-$json}" | head -c 300)"
		return 1
	fi
	used=${used%%.*}
	case $used in "" | *[!0-9]*) used=0 ;; esac
	ndays=$(days_in_month "$year" "$month")
	pct=$(projected_pct "$used" "$day" "$ndays" "$quota")
	log "CI minutes: $used of $quota by day $day of $ndays, projected $((used * ndays / day)) at the month's end ($pct%), budget $budget%"
	[ "$pct" -gt "$budget" ]
}

DEFAULT_RUNTIME_PATHS='Dockerfile* uv.lock requirements*.txt pyproject.toml package.json package-lock.json go.mod go.sum composer.*'

# The files changed between a tag and HEAD that are runtime inputs, one per
# line: those matching AUTO_RELEASE_RUNTIME_PATHS. A pattern with a / matches
# the path from the repository root, one without a / the file name in any
# directory, so Dockerfile* also covers tools/Dockerfile. The net change
# counts: an update reverted before the release changed nothing.
runtime_files() {
	patterns=$(printf '%s\n' "${AUTO_RELEASE_RUNTIME_PATHS:-$DEFAULT_RUNTIME_PATHS}" | tr ',' ' ')
	git diff --name-only "$1" HEAD | while IFS= read -r file; do
		name=${file##*/}
		set -f
		for pattern in $patterns; do
			case $pattern in */*) subject=$file ;; *) subject=$name ;; esac
			# shellcheck disable=SC2254 # the pattern is meant to match
			case $subject in $pattern)
				printf '%s\n' "$file"
				break
				;;
			esac
		done
		set +f
	done
}

# Maintenance release: dependency updates (chore(deps), which release
# nothing under conventional) still have to reach users. They do when
# unreleased commits changed a runtime input and the last release is
# AUTO_RELEASE_MAINTENANCE_DAYS old, so a repository whose runtime inputs
# stand still never rebuilds, and one with weekly updates releases at most
# once a period. Sets MAINTENANCE_NOTE.
maintenance_due() {
	days=$(maintenance_days)
	if [ "$days" -eq 0 ]; then
		log "Maintenance release: off (AUTO_RELEASE_MAINTENANCE_DAYS=0)"
		return 1
	fi
	changed=$(runtime_files "$1")
	if [ -z "$changed" ]; then
		log "Maintenance release: no runtime input changed since $1"
		return 1
	fi
	age=$(($(date +%s) - $(tag_time "$1")))
	if ! old_enough "$age" "$days"; then
		log "Maintenance release: runtime inputs changed, but $1 is $(age_days "$age") days old, under $days days"
		return 1
	fi
	# On GitLab every release build costs CI minutes: past the budget, wait
	# the longer period. The query runs only when its answer matters.
	slow=$(whole_days AUTO_RELEASE_MAINTENANCE_DAYS_OVER_BUDGET 28)
	if [ "$FORGE" = gitlab ] && ! old_enough "$age" "$slow" && minutes_over_budget; then
		log "Maintenance release: CI minutes over budget, so it waits $slow days; $1 is $(age_days "$age") days old"
		return 1
	fi
	log "Maintenance release: $1 is $(age_days "$age") days old and runtime inputs changed"
	MAINTENANCE_NOTE=$(printf '%s\n' "$changed" | sort -u | awk '{printf "- `%s`\n", $0}')
}

# When a tag was made: the tagger date of an annotated tag, which auto-release
# pushes, or the commit date of a lightweight one, which can only be earlier.
tag_time() {
	git for-each-ref --format='%(creatordate:unix)' "refs/tags/$1"
}

# Whether a release AGE seconds old has reached a gate of DAYS. Scheduled runs
# start late, by a different amount each week (GitHub's Monday 06:00 UTC run
# has started anywhere from 12:00 to 15:20), so a gate counted to the second
# made a weekly run that started earlier than last week's wait a whole extra
# week. Half a day of slack keeps a 7-day gate weekly.
old_enough() {
	[ "$1" -ge $(($2 * 86400 - 43200)) ]
}

# AGE seconds in whole days, rounded the way old_enough counts them.
age_days() {
	echo $((($1 + 43200) / 86400))
}

# The Dockerfile AUTO_RELEASE_IMAGE is built from: the only listed one that
# exists at the last tag. Fails, saying why, when several do, since the image
# cannot be matched to one of them; fails quietly when none does.
release_dockerfile() {
	found="" several=""
	for df in $(dockerfiles); do
		df=${df#./}
		git cat-file -e "$1:./$df" 2>/dev/null || continue
		[ -z "$found" ] || several=true
		found=$df
	done
	if [ -n "$several" ]; then
		log "Fresh rebuild check: several Dockerfiles but one AUTO_RELEASE_IMAGE, which cannot be matched to one of them (list each image with its Dockerfile in AUTO_RELEASE_IMAGES); skipping"
		return 1
	fi
	[ -n "$found" ] || return 1
	printf '%s' "$found"
}

# The images of AUTO_RELEASE_IMAGES, one "IMAGE DOCKERFILE" line each: entries
# IMAGE=DOCKERFILE separated by spaces or commas, the Dockerfile a path from
# the repository root, Dockerfile when the entry has none. Every image of a
# release carries the same tag, so an image reference must not have one.
rebuild_images() {
	set -f
	for entry in $(printf '%s\n' "${AUTO_RELEASE_IMAGES:-}" | tr ',' ' '); do
		ref=${entry%%=*}
		case $entry in *=*) df=${entry#*=} ;; *) df=Dockerfile ;; esac
		case ${ref##*/} in
		"" | *:* | *@*) die "AUTO_RELEASE_IMAGES: '$entry' is not IMAGE=DOCKERFILE with an image without a tag or digest" ;;
		esac
		[ -n "$df" ] || die "AUTO_RELEASE_IMAGES: '$entry' has an empty Dockerfile"
		printf '%s %s\n' "$ref" "${df#./}"
	done
	set +f
}

# Fresh rebuild: the image of the last release has fixable HIGH/CRITICAL
# findings in packages its Dockerfile installs (apk add, apt-get install
# without versions), which a build from scratch picks up once the distribution
# ships the fix, while nothing in the repository changes to trigger one. A
# finding counts when it is in an OS package of the image at the last version
# and not in the final-stage base image at the last tag, whose own fixes need
# a base image update instead, unless the final stage upgrades its OS
# packages (apt-get upgrade, apk upgrade): then a rebuild fixes those too,
# without waiting for the base image's maintainers. Language packages are left
# out: lock files and pinned versions keep them as they are, so a rebuild
# would not fix them. Only when the last tag is AUTO_RELEASE_REBUILD_DAYS old,
# so a fix that is not out yet costs one release per period, not one per run.
#
# The images are AUTO_RELEASE_IMAGES, each with its Dockerfile, else
# AUTO_RELEASE_IMAGE with the one Dockerfile listed. A release builds every
# image, so one image with such findings releases. Sets REBUILD_NOTE. An image
# that cannot be resolved or scanned is skipped, never failing the run.
rebuild_fixes_cves() {
	days=$(rebuild_days)
	[ "$days" -gt 0 ] || return 1
	if [ -n "${AUTO_RELEASE_IMAGES:-}" ]; then
		targets=$(rebuild_images)
		named=true
	else
		df=$(release_dockerfile "$1") || return 1
		if [ -z "${AUTO_RELEASE_IMAGE:-}" ]; then
			log "Fresh rebuild check: no AUTO_RELEASE_IMAGE to scan; skipping"
			return 1
		fi
		targets="$AUTO_RELEASE_IMAGE $df"
		named=false
	fi
	age=$(($(date +%s) - $(tag_time "$1")))
	if ! old_enough "$age" "$days"; then
		log "Fresh rebuild check: $1 is $(age_days "$age") days old, under AUTO_RELEASE_REBUILD_DAYS=$days"
		return 1
	fi
	note="" rebuilt=""
	# fd 3, so nothing the scans run reads the list from stdin.
	while read -r ref df <&3; do
		image_rebuild_fixes "$1" "$ref" "$df" "$named" || continue
		log "Fresh rebuild check: $1 is $(age_days "$age") days old and a rebuild of $ref should fix $(printf '%s\n' "$added" | grep -c .) findings"
		rebuilt=$(printf '%s\n%s' "$rebuilt" "$ref")
		if [ "$named" = true ]; then
			what="the image \`$ref\`"
		else
			what="the image"
		fi
		note=$(printf '%s\n\nA fresh build of the packages %s installs on top of its base image is expected to fix these findings of %s:\n\n%s' \
			"$note" "$what" "$1" "$(printf '%s\n' "$added" | awk '{printf "- %s in `%s`\n", $1, $2}')")
	done 3<<-EOF
		$targets
	EOF
	[ -n "$note" ] || return 1
	REBUILD_NOTE=$(printf '%s\n' "$note" | sed -e '/./,$!d')
	REBUILD_IMAGES=$(printf '%s\n' "$rebuilt" | grep .)
}

# One image of the fresh rebuild check: image_rebuild_fixes TAG IMAGE
# DOCKERFILE NAMED. Sets added to the findings a rebuild should fix, as "CVE
# package" lines; fails, saying why, when there are none or the image is
# skipped. NAMED=true names the image in the log lines, for several images.
image_rebuild_fixes() {
	image="$2:$(image_tag "$1")" df=$3 added=""
	skip="the fresh rebuild check"
	[ "$4" != true ] || skip=$2
	if ! git cat-file -e "$1:./$df" 2>/dev/null; then
		log "Fresh rebuild check: $df, which $2 is built from, is not in $1; skipping $2"
		return 1
	fi
	if ! base=$(git show "$1:./$df" | dockerfile_base); then
		log "warning: cannot resolve the base image of $df in $1 (an ARG without a default?); skipping $skip"
		return 1
	fi
	registry_login
	if ! released=$(image_vulns "$image" os); then
		log "warning: cannot scan $image; skipping $skip"
		return 1
	fi
	from_base=""
	if git show "$1:./$df" | final_stage_upgrades; then
		log "Fresh rebuild check: $df upgrades its OS packages, so the base image's findings count too"
	elif [ -n "$base" ] && ! from_base=$(image_vulns "$base" os); then
		log "warning: cannot scan $base; skipping $skip"
		return 1
	fi
	added=$(printf '%s\n' "$released" | grep -vxF -f "$(printf '%s\n' "$from_base" | tmpfile)" | grep . || true)
	log "Fixable HIGH/CRITICAL in OS packages of $image: $(printf '%s' "$released" | grep -c . || true), of its base ${base:-scratch}: $(printf '%s' "$from_base" | grep -c . || true)"
	if [ -z "$added" ]; then
		log "Fresh rebuild check: none in the packages $df installs"
		return 1
	fi
}

# Reads a Dockerfile on stdin; succeeds when its final stage upgrades the OS
# packages (apt-get or apt upgrade or dist-upgrade, apk upgrade), so a fresh
# build also picks up the fixes the base image doesn't have yet. Comments and
# earlier stages don't count.
final_stage_upgrades() {
	awk '
	/^[ \t]*#/ { next }
	toupper($1) == "FROM" { stage = ""; next }
	{ stage = stage " " $0 }
	END { exit !(stage ~ /(apt-get|apt)[ \t]+([^ \t&;|]+[ \t]+)*(dist-)?upgrade|apk[ \t]+([^ \t&;|]+[ \t]+)*upgrade/) }'
}

tmpfile() {
	f=$(mktemp)
	cat >"$f"
	printf '%s' "$f"
}

# Logs in to the forge's registry when AUTO_RELEASE_IMAGE or an image of
# AUTO_RELEASE_IMAGES is on it.
registry_login() {
	[ -n "${REGISTRY_LOGIN:-}" ] || return 0
	registry=${REGISTRY_LOGIN% *} user=${REGISTRY_LOGIN#* }
	password=${REGISTRY_PASSWORD:-$FORGE_TOKEN}
	case " ${AUTO_RELEASE_IMAGE:-} $(printf '%s' "${AUTO_RELEASE_IMAGES:-}" | tr ',' ' ') " in
	*" $registry"/*) ;;
	*) return 0 ;;
	esac
	[ -n "$password" ] || return 0
	printf '%s' "$password" | crane auth login "$registry" -u "$user" --password-stdin >/dev/null 2>&1 ||
		log "warning: could not log in to $registry; trying anonymously"
}

cliff_config() {
	if [ -n "${AUTO_RELEASE_CONFIG:-}" ]; then
		printf '%s' "$AUTO_RELEASE_CONFIG"
	elif [ -f cliff.toml ]; then
		printf cliff.toml
	else
		printf '%s/cliff.toml' "$SHARE_DIR"
	fi
}

cliff() {
	AUTO_RELEASE_COMMIT_URL=$COMMIT_URL NO_COLOR=1 GIT_CLIFF_OFFLINE=true \
		git-cliff --config "$(cliff_config)" --tag-pattern "$TAG_PATTERN" "$@"
}

# Sets NEEDED, NEXT_TAG, NOTES_FILE.
plan() {
	NEEDED=false NEXT_TAG="" SECURITY_NOTE="" REBUILD_NOTE="" REBUILD_IMAGES="" MAINTENANCE_NOTE=""
	rebuild_days >/dev/null
	rebuild_images >/dev/null
	maintenance_days >/dev/null
	whole_days AUTO_RELEASE_MAINTENANCE_DAYS_OVER_BUDGET 28 >/dev/null
	whole_number AUTO_RELEASE_MINUTES_BUDGET_PCT 85 >/dev/null
	whole_number AUTO_RELEASE_MINUTES_QUOTA 400 >/dev/null
	LATEST_TAG=$(latest_tag)
	if [ -z "$LATEST_TAG" ]; then
		log "No release tag matching $TAG_PATTERN found: push an initial tag by hand to bootstrap. Skipping."
		return 0
	fi
	log "Latest tag: $LATEST_TAG"
	version=${LATEST_TAG#v}
	version=${version%%+*}
	count=$(git rev-list --count "${LATEST_TAG}..HEAD")
	log "Commits since $LATEST_TAG: $count"
	# What the tag records about the upstream, its build metadata
	# (AUTO_RELEASE_METADATA_CMD), now and at the latest tag. A change releases
	# under the commits and conventional strategies, so the tags never lag
	# behind the pin, whatever type the commit that moved it had.
	PIN="" LATEST_PIN=""
	if [ -n "$METADATA_CMD" ]; then
		PIN=$(command_value AUTO_RELEASE_METADATA_CMD "$METADATA_CMD" '^[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*$') || exit 1
		case $LATEST_TAG in *+*) LATEST_PIN=${LATEST_TAG#*+} ;; esac
	fi
	pin_changed=false
	if [ "$PIN" != "$LATEST_PIN" ]; then
		pin_changed=true
		log "Upstream pin changed since $LATEST_TAG: ${LATEST_PIN:-none} -> $PIN"
	fi

	case $STRATEGY in
	commits)
		[ "$count" -gt 0 ] && NEEDED=true
		[ "$pin_changed" = true ] && NEEDED=true
		if rebuild_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		;;
	conventional)
		if [ "$count" -gt 0 ] && has_releasable_commits "$LATEST_TAG"; then
			NEEDED=true
		elif [ "$pin_changed" = true ]; then
			NEEDED=true
		elif [ "$count" -gt 0 ]; then
			log "No feat/fix/perf/revert or breaking commit since $LATEST_TAG."
			if maintenance_due "$LATEST_TAG"; then
				NEEDED=true
			fi
		fi
		# The weekly run is what catches a fix the distribution shipped
		# while the repository stood still.
		if rebuild_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		;;
	security)
		# Runs on every push, outside the weekly rhythm: release at once only
		# for a CVE fix, either a Renovate fix(security) update, a base image
		# update that drops fixable HIGH/CRITICAL findings, or a fresh
		# rebuild that should drop them from the packages the image adds.
		if [ "$count" -gt 0 ] && has_security_commits "$LATEST_TAG"; then
			NEEDED=true
		fi
		if base_image_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		if rebuild_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		[ "$NEEDED" = true ] || log "No security fix since $LATEST_TAG."
		;;
	*) die "unknown strategy '$STRATEGY' (commits, conventional or security)" ;;
	esac

	if [ "$NEEDED" != true ]; then
		log "No release needed."
		return 0
	fi

	# A maintenance release has no feat or breaking commit by definition. For
	# the rest git-cliff applies the Conventional Commit rules; when every
	# commit is one the config skips (merges, chore(release)) it reports no
	# bump, and a commit still landed, so release a patch.
	if [ "$count" -eq 0 ] || [ -n "$MAINTENANCE_NOTE" ]; then
		NEXT_TAG=$(bump "$version" patch)
	else
		# git-cliff carries the latest tag's build metadata over; the
		# current one is appended below.
		NEXT_TAG=$(cliff --bumped-version)
		NEXT_TAG=${NEXT_TAG%%+*}
		case $NEXT_TAG in v*) ;; *) NEXT_TAG=v$NEXT_TAG ;; esac
		if ! printf '%s' "$NEXT_TAG" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
			die "git-cliff proposed '$NEXT_TAG', not a vX.Y.Z version"
		fi
		# git-cliff bumps from the last release it has notes for. When every
		# commit since the last tag is one the config skips (digest updates,
		# merges), and the release before was such a release too, that is an
		# older tag, so its proposal is the latest version or below it: release
		# a patch instead.
		version_above "${NEXT_TAG#v}" "$version" || NEXT_TAG=$(bump "$version" patch)
	fi
	if [ -n "$METADATA_CMD" ]; then
		NEXT_TAG="$NEXT_TAG+$PIN"
	fi
	log "Next tag: $NEXT_TAG"

	NOTES_FILE=$(mktemp)
	{
		if [ -n "$SECURITY_NOTE$REBUILD_NOTE" ]; then
			if [ "$(rebuild_images | wc -l)" -gt 1 ]; then
				printf '### Security fixes in the images\n\n'
			else
				printf '### Security fixes in the image\n\n'
			fi
		fi
		if [ -n "$SECURITY_NOTE" ]; then
			printf '%s\n\n' "$SECURITY_NOTE"
		fi
		if [ -n "$REBUILD_NOTE" ]; then
			printf '%s\n\n' "$REBUILD_NOTE"
		fi
		if [ -n "$MAINTENANCE_NOTE" ]; then
			printf '### Maintenance release\n\nRuntime inputs changed since %s:\n\n%s\n\n' "$LATEST_TAG" "$MAINTENANCE_NOTE"
		fi
		if [ -n "${AUTO_RELEASE_BASE_IMAGE_PATTERN:-}" ] && [ -f Dockerfile ]; then
			base=$(grep -E "$AUTO_RELEASE_BASE_IMAGE_PATTERN" Dockerfile || true)
			if [ -n "$base" ]; then
				# shellcheck disable=SC2016 # Markdown fence, not a command substitution
				printf 'Base image:\n```\n%s\n```\n\n' "$base"
			fi
		fi
		# The range, not --unreleased: the notes cover exactly the commits
		# since the latest tag, whichever tag git-cliff would pick.
		notes=$(cliff "${LATEST_TAG}..HEAD" --tag "$NEXT_TAG" --strip all)
		notes=$(printf '%s\n' "$notes" | sed -e '/./,$!d')
		if [ -n "$notes" ]; then
			printf '%s\n' "$notes"
		elif [ "$count" -eq 0 ]; then
			printf 'No commits since %s.\n' "$LATEST_TAG"
		else
			printf 'No notable changes since %s.\n' "$LATEST_TAG"
		fi
		if [ -n "$COMPARE_URL" ]; then
			# A + in a URL path is literal, but forges route it unevenly.
			printf '\n**Full changelog:** %s%s...%s\n' "$COMPARE_URL" \
				"$(printf '%s' "$LATEST_TAG" | sed 's/+/%2B/g')" "$(printf '%s' "$NEXT_TAG" | sed 's/+/%2B/g')"
		fi
	} >"$NOTES_FILE"
}

report() {
	if [ -n "${GITHUB_OUTPUT:-}" ]; then
		{
			printf 'released=%s\n' "$1"
			printf 'tag=%s\n' "$NEXT_TAG"
		} >>"$GITHUB_OUTPUT"
	fi
	[ "$NEEDED" = true ] || return 0
	printf '## %s\n\n' "$NEXT_TAG"
	cat "$NOTES_FILE"
	if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
		{
			if [ "$1" = true ]; then printf '## Released %s\n\n' "$NEXT_TAG"; else printf '## Next release: %s (not tagged)\n\n' "$NEXT_TAG"; fi
			cat "$NOTES_FILE"
		} >>"$GITHUB_STEP_SUMMARY"
	fi
}

# The annotated tag's message: the tag, then one "Fresh rebuild: IMAGE" line
# for each image a fresh rebuild is due for. A build that reuses the images
# whose inputs did not change (GitLab's CI_COMMIT_TAG_MESSAGE) reads it to
# rebuild those anyway.
tag_message() {
	printf '%s\n' "$NEXT_TAG"
	[ -n "$REBUILD_IMAGES" ] || return 0
	printf '\n'
	printf '%s\n' "$REBUILD_IMAGES" | sed 's/^/Fresh rebuild: /'
}

release() {
	[ -n "$FORGE_TOKEN" ] || die "no token: set AUTO_RELEASE_TOKEN (GitHub and Forgejo also take GITHUB_TOKEN)"
	# Annotated, so the tag records when it was made (the fresh rebuild
	# check counts days from it), and unsigned, whatever the runner's config
	# says. A job container often has no git identity: fall back to one.
	git var GIT_COMMITTER_IDENT >/dev/null 2>&1 ||
		set -- -c user.name=auto-release -c user.email=auto-release@localhost
	git "$@" -c tag.gpgSign=false -c tag.forceSignAnnotated=false tag -a -F "$(tag_message | tmpfile)" "$NEXT_TAG"
	if ! out=$(git push --quiet "$PUSH_URL" "refs/tags/${NEXT_TAG}" 2>&1); then
		printf '%s\n' "$out" | sed "s|${FORGE_TOKEN}|***|g" >&2
		die "pushing $NEXT_TAG failed"
	fi
	log "Pushed $NEXT_TAG"
	# The tag is out either way: start its build even if the Release failed,
	# then fail the job so the missing Release gets noticed.
	rc=0
	if forge_release "$NEXT_TAG" "$NOTES_FILE"; then
		log "Created the $FORGE Release for $NEXT_TAG"
	else
		log "auto-release: creating the Release for $NEXT_TAG failed"
		rc=1
	fi
	forge_dispatch "$NEXT_TAG" || rc=1
	return "$rc"
}

# A job container runs as root on a checkout owned by the runner's user, and
# actions/checkout records safe.directory only under a temporary HOME, so git
# and git-cliff (libgit2) refuse the repository as dubious ownership. In CI the
# checkout is the job's own: trust it, for this process only. libgit2 reads
# neither -c nor GIT_CONFIG_*, only the global file, hence a temporary HOME
# whose .gitconfig includes the real one.
trust_checkout() {
	global=${GIT_CONFIG_GLOBAL:-${HOME:-/nonexistent}/.gitconfig}
	home=$(mktemp -d)
	{
		if [ -f "$global" ]; then
			printf '[include]\n\tpath = %s\n' "$global"
		fi
		printf '[safe]\n\tdirectory = *\n\tdirectory = %s\n' "$(pwd -P)"
	} >"$home/.gitconfig"
	if [ -d "${HOME:-/nonexistent}/.docker" ]; then
		export DOCKER_CONFIG="${DOCKER_CONFIG:-$HOME/.docker}"
	fi
	export HOME="$home" GIT_CONFIG_GLOBAL="$home/.gitconfig"
}

on_tag_ref() {
	ON_TAG=${CI_COMMIT_TAG:-}
	case ${GITHUB_REF:-} in refs/tags/*) ON_TAG=${GITHUB_REF#refs/tags/} ;; esac
	[ -n "$ON_TAG" ]
}

main() {
	command=plan
	is_true "${AUTO_RELEASE_DRY_RUN:-}" || command=${1:-release}
	case ${1:-} in -h | --help | help) usage ;; esac
	case $command in plan | release) ;; *) log "unknown command '$command'"; usage 2 ;; esac

	STRATEGY=${AUTO_RELEASE_STRATEGY:-commits}
	# Checked here as well as in plan, so a wrong name fails even where plan
	# stops early (no tag yet, a tag ref).
	case $STRATEGY in commits | conventional | security) ;; *) die "unknown strategy '$STRATEGY' (commits, conventional or security)" ;; esac
	METADATA_CMD=${AUTO_RELEASE_METADATA_CMD:-}
	if [ -n "${AUTO_RELEASE_UPSTREAM_CMD:-}" ]; then
		die "AUTO_RELEASE_UPSTREAM_CMD (v<upstream>+r<N> tags) was removed in 2.0.0: use AUTO_RELEASE_METADATA_CMD (vX.Y.Z+<metadata>)"
	fi
	FORGE=$(detect_forge)
	case $FORGE in github | gitlab | forgejo | none) ;; *) die "unknown forge '$FORGE'" ;; esac
	# A release run on a tag ref is the tag build it dispatched itself, and
	# releases are cut from branches: it must not tag again.
	if [ "$command" = release ] && on_tag_ref; then
		log "Running on tag ${ON_TAG}: releases are cut from branches. Skipping."
		return 0
	fi

	[ "$FORGE" = none ] || trust_checkout

	if ! err=$(git rev-parse --git-dir 2>&1 >/dev/null); then
		die "not inside a usable git repository: $err"
	fi
	if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
		die "shallow clone: fetch the full history (fetch-depth: 0 / GIT_DEPTH: 0)"
	fi
	"setup_$FORGE"
	# Tests push to a local bare repository instead.
	PUSH_URL=${AUTO_RELEASE_PUSH_URL:-$PUSH_URL}
	log "Forge: $FORGE, strategy: $STRATEGY"
	if [ "$command" = release ] && [ "$FORGE" = none ]; then
		die "no forge detected, so nothing to release to: run 'auto-release plan' or set AUTO_RELEASE_FORGE"
	fi

	if git remote get-url origin >/dev/null 2>&1; then
		git fetch --quiet --tags origin 2>/dev/null || log "warning: could not fetch tags; using the local ones"
	fi
	plan
	if [ "$command" = plan ] || [ "$NEEDED" != true ]; then
		report false
		return 0
	fi
	release_rc=0
	release || release_rc=$?
	report true
	return "$release_rc"
}

main "$@"
