#!/bin/sh
# auto-release: tag the next semantic version and publish a forge Release with
# grouped notes, without a release pull request. Runs the same way on GitHub
# Actions, GitLab CI and Forgejo Actions; see README.md.
#
#   auto-release plan       print the next version and its notes, change nothing
#   auto-release release    plan, then push the tag and create the Release
#
# Configuration comes from the environment (CI jobs set it from their inputs):
#   AUTO_RELEASE_STRATEGY            commits (default) | conventional | docker | security
#   AUTO_RELEASE_IMAGE               docker: image to compare (GitLab: $CI_REGISTRY_IMAGE)
#   AUTO_RELEASE_DOCKERFILES         security: Dockerfiles whose base image to compare,
#                                    separated by spaces or commas (default Dockerfile)
#   AUTO_RELEASE_REBUILD_DAYS        commits, conventional, security: release a fresh
#                                    rebuild when the last release is this many days old
#                                    and its image has fixable findings its base lacks
#                                    (default 7; 0 disables)
#   AUTO_RELEASE_BASE_IMAGE_PATTERN  egrep pattern; matching Dockerfile lines go into the notes
#   AUTO_RELEASE_TOKEN               token that pushes the tag and creates the Release
#                                    (GitHub/Forgejo fall back to GITHUB_TOKEN)
#   AUTO_RELEASE_DISPATCH            false: do not start the tag build (GitHub/Forgejo)
#   AUTO_RELEASE_DISPATCH_WORKFLOW   workflow file to start on the tag (GitHub defaults
#                                    to the caller of the running workflow)
#   AUTO_RELEASE_CONFIG              git-cliff config (default ./cliff.toml, else bundled)
#   AUTO_RELEASE_FORGE               github | gitlab | forgejo | none (default: detected)
#   AUTO_RELEASE_DRY_RUN             true: same as the plan command
set -eu

TAG_PATTERN='^v[0-9]+\.[0-9]+\.[0-9]+$'
SHARE_DIR=${AUTO_RELEASE_SHARE_DIR:-$(cd "$(dirname "$0")/../share/auto-release" && pwd)}

log() { printf '%s\n' "$*" >&2; }
die() { log "auto-release: $*"; exit 1; }

usage() {
	sed -n '2,/^set -eu$/{/^set -eu$/d;s/^# \{0,1\}//;p;}' "$0"
	exit "${1:-0}"
}

is_true() { case ${1:-} in true | 1 | yes) return 0 ;; *) return 1 ;; esac; }

# Calls a forge API. curl's --fail-with-body keeps the error body, which says
# why (missing scope, tag already released) far better than the status code.
api() {
	method=$1 url=$2 auth=$3 body=${4:-}
	if [ -n "$body" ]; then
		printf '%s' "$body" | curl -sS --fail-with-body --retry 3 -X "$method" \
			-H "$auth" -H 'Content-Type: application/json' -H 'Accept: application/json' \
			--data @- "$url"
	else
		curl -sS --fail-with-body --retry 3 -X "$method" -H "$auth" -H 'Accept: application/json' "$url"
	fi
}

# --- forge adapters ----------------------------------------------------------
# Each forge sets: FORGE_TOKEN, PUSH_URL, COMMIT_URL, COMPARE_URL (prefixes) and
# implements forge_release TAG NOTES_FILE and forge_dispatch TAG.

detect_forge() {
	if [ -n "${AUTO_RELEASE_FORGE:-}" ]; then
		printf '%s' "$AUTO_RELEASE_FORGE"
	elif is_true "${FORGEJO_ACTIONS:-}" || is_true "${GITEA_ACTIONS:-}"; then
		# Before GITHUB_ACTIONS: Forgejo's runner sets that too.
		printf forgejo
	elif is_true "${GITHUB_ACTIONS:-}"; then
		printf github
	elif is_true "${GITLAB_CI:-}"; then
		printf gitlab
	else
		printf none
	fi
}

# Host part of a URL, for an authenticated push URL.
url_host() { printf '%s' "$1" | sed -E 's|^[a-z]+://||; s|/.*$||'; }

setup_github() {
	FORGE_TOKEN=${AUTO_RELEASE_TOKEN:-${GITHUB_TOKEN:-}}
	server=${GITHUB_SERVER_URL:-https://github.com}
	repo=${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}
	FORGE_API=${GITHUB_API_URL:-https://api.github.com}
	PUSH_URL="https://x-access-token:${FORGE_TOKEN}@$(url_host "$server")/${repo}.git"
	COMMIT_URL="${server}/${repo}/commit/"
	COMPARE_URL="${server}/${repo}/compare/"
	REGISTRY_LOGIN="ghcr.io x-access-token"
}

setup_forgejo() {
	FORGE_TOKEN=${AUTO_RELEASE_TOKEN:-${GITHUB_TOKEN:-}}
	server=${GITHUB_SERVER_URL:?GITHUB_SERVER_URL is not set}
	repo=${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}
	FORGE_API="${server}/api/v1"
	PUSH_URL="https://x-access-token:${FORGE_TOKEN}@$(url_host "$server")/${repo}.git"
	COMMIT_URL="${server}/${repo}/commit/"
	COMPARE_URL="${server}/${repo}/compare/"
	REGISTRY_LOGIN="$(url_host "$server") x-access-token"
}

setup_gitlab() {
	FORGE_TOKEN=${AUTO_RELEASE_TOKEN:-}
	FORGE_API=${CI_API_V4_URL:?CI_API_V4_URL is not set}
	PUSH_URL="${CI_SERVER_PROTOCOL:-https}://oauth2:${FORGE_TOKEN}@${CI_SERVER_FQDN:-${CI_SERVER_HOST:?}}/${CI_PROJECT_PATH:?}.git"
	COMMIT_URL="${CI_PROJECT_URL:?}/-/commit/"
	COMPARE_URL="${CI_PROJECT_URL}/-/compare/"
	AUTO_RELEASE_IMAGE=${AUTO_RELEASE_IMAGE:-${CI_REGISTRY_IMAGE:-}}
	REGISTRY_LOGIN=""
	# The job token reads the project's own registry; no API scope needed.
	if [ -n "${CI_REGISTRY:-}" ] && [ -n "${CI_JOB_TOKEN:-}" ]; then
		REGISTRY_LOGIN="$CI_REGISTRY gitlab-ci-token"
		REGISTRY_PASSWORD=$CI_JOB_TOKEN
	fi
}

setup_none() {
	FORGE_TOKEN="" PUSH_URL="" COMMIT_URL="" COMPARE_URL="" REGISTRY_LOGIN=""
}

release_json() {
	jq -cn --arg tag "$1" --rawfile body "$2" \
		'{tag_name: $tag, name: $tag, body: $body, draft: false, prerelease: false}'
}

forge_release() {
	case $FORGE in
	github)
		api POST "${FORGE_API}/repos/${GITHUB_REPOSITORY}/releases" \
			"Authorization: Bearer ${FORGE_TOKEN}" "$(release_json "$1" "$2")" >/dev/null
		;;
	forgejo)
		api POST "${FORGE_API}/repos/${GITHUB_REPOSITORY}/releases" \
			"Authorization: token ${FORGE_TOKEN}" "$(release_json "$1" "$2")" >/dev/null
		;;
	gitlab)
		api POST "${FORGE_API}/projects/${CI_PROJECT_ID:?}/releases" \
			"PRIVATE-TOKEN: ${FORGE_TOKEN}" \
			"$(jq -cn --arg tag "$1" --rawfile body "$2" '{tag_name: $tag, name: $tag, description: $body}')" >/dev/null
		;;
	esac
}

# The workflow file to start on the new tag. In a reusable GitHub workflow
# GITHUB_WORKFLOW_REF names the caller: owner/repo/.github/workflows/ci.yml@ref.
dispatch_workflow() {
	wf=${AUTO_RELEASE_DISPATCH_WORKFLOW:-${GITHUB_WORKFLOW_REF:-}}
	wf=${wf%@*}
	printf '%s' "${wf##*/}"
}

# A tag pushed with GitHub's GITHUB_TOKEN starts no workflow run (Forgejo's
# automatic token behaves the same), so start the tag build explicitly;
# workflow_dispatch is the one event those tokens may trigger. GitLab needs
# nothing: a tag pushed with a personal or project token runs a pipeline.
forge_dispatch() {
	is_true "${AUTO_RELEASE_DISPATCH:-true}" || return 0
	case $FORGE in github | forgejo) ;; *) return 0 ;; esac
	wf=$(dispatch_workflow)
	if [ -z "$wf" ]; then
		log "No workflow to dispatch on $1 (set AUTO_RELEASE_DISPATCH_WORKFLOW); skipping."
		return 0
	fi
	if [ "$FORGE" = github ]; then
		auth="Authorization: Bearer ${FORGE_TOKEN}"
	else
		auth="Authorization: token ${FORGE_TOKEN}"
	fi
	api POST "${FORGE_API}/repos/${GITHUB_REPOSITORY}/actions/workflows/${wf}/dispatches" \
		"$auth" "$(jq -cn --arg ref "$1" '{ref: $ref}')" >/dev/null
	log "Dispatched ${wf} on $1"
}

# --- planning ----------------------------------------------------------------

latest_tag() {
	git tag --list 'v*.*.*' --sort=-version:refname | grep -E "$TAG_PATTERN" | head -n 1 || true
}

bump() { # VERSION(without v) KIND
	major=${1%%.*} rest=${1#*.}
	minor=${rest%%.*} patch=${rest#*.}
	case $2 in
	major) printf 'v%s.0.0' "$((major + 1))" ;;
	minor) printf 'v%s.%s.0' "$major" "$((minor + 1))" ;;
	patch) printf 'v%s.%s.%s' "$major" "$minor" "$((patch + 1))" ;;
	esac
}

# conventional: only commits that change the version for a user count, the same
# set release-please releases for. docs/chore/ci/test/refactor alone do not.
has_releasable_commits() {
	git log "$1..HEAD" --no-merges --format='%s%n%b' |
		grep -qE '^(feat|fix|perf|revert)(\([^)]*\))?!?:|^[a-zA-Z]+(\([^)]*\))?!:|^BREAKING[ -]CHANGE:'
}

# security: a CVE fix commit since the last tag. Only fix(security), the type
# Renovate gives its vulnerability updates: a chore(security) or build(security)
# commit (a dev-only dependency, say) changes nothing users run.
has_security_commits() {
	git log "$1..HEAD" --no-merges --format='%s' | grep -qE '^fix\(security\)!?:'
}

# Fixable HIGH/CRITICAL findings of an image as sorted "CVE package" lines,
# the same filter image-cve-alert reports with. A .trivyignore in the checkout
# applies (trivy reads it by default). With a second argument "os", only the
# distribution's packages (apk, apt) count. Fails when the image cannot be
# scanned.
image_vulns() {
	json=$(trivy image --quiet --image-src remote --scanners vuln --ignore-unfixed \
		--severity "${AUTO_RELEASE_SEVERITY:-HIGH,CRITICAL}" --format json "$1") || return 1
	printf '%s' "$json" | jq -r --arg only "${2:-}" '.Results[]? |
		select($only != "os" or .Class == "os-pkgs") |
		.Vulnerabilities[]? | "\(.VulnerabilityID) \(.PkgName)"' | sort -u
}

# The Dockerfiles whose base image the security strategy compares:
# AUTO_RELEASE_DOCKERFILES with commas turned into spaces, for word splitting.
dockerfiles() {
	printf '%s\n' "${AUTO_RELEASE_DOCKERFILES:-Dockerfile}" | tr ',' ' '
}

# Reads a Dockerfile on stdin and prints the base image of its final stage:
# the last FROM, with --platform and other flags dropped, ${VAR}, ${VAR:-x}
# and $VAR taken from the ARG defaults before the first FROM (the only ones a
# FROM can use), and a FROM of an earlier stage followed to that stage's
# image. Prints nothing for scratch, or a Dockerfile without FROM; fails when a
# variable has no value, since then the image depends on a --build-arg.
dockerfile_base() {
	awk '
	function expand(s,   out, tok, i, def) {
		out = ""
		while (match(s, /\$\{[A-Za-z_][A-Za-z0-9_]*(:-[^}]*)?\}|\$[A-Za-z_][A-Za-z0-9_]*/)) {
			tok = substr(s, RSTART, RLENGTH)
			out = out substr(s, 1, RSTART - 1)
			s = substr(s, RSTART + RLENGTH)
			if (substr(tok, 2, 1) == "{") tok = substr(tok, 3, length(tok) - 3)
			else tok = substr(tok, 2)
			def = ""
			if ((i = index(tok, ":-")) > 0) {
				def = substr(tok, i + 2)
				tok = substr(tok, 1, i - 1)
			}
			if (args[tok] != "") out = out args[tok]
			else if (def != "") out = out def
			else unresolved = 1
		}
		return out s
	}
	function unquote(v,   c) {
		c = substr(v, 1, 1)
		if (length(v) > 1 && (c == "\"" || c == sq) && substr(v, length(v)) == c) v = substr(v, 2, length(v) - 2)
		return v
	}
	BEGIN { sq = sprintf("%c", 39) }
	{ sub(/\r$/, "") }
	/^[ \t]*#/ { next }
	/\\$/ { buf = buf substr($0, 1, length($0) - 1) " "; next }
	{
		line = buf $0
		buf = ""
		n = split(line, f, /[ \t]+/)
		k = (f[1] == "") ? 2 : 1
		instr = toupper(f[k])
		if (instr == "ARG" && stages == 0) {
			for (j = k + 1; j <= n; j++) {
				if (f[j] == "") continue
				if ((e = index(f[j], "=")) > 0) args[substr(f[j], 1, e - 1)] = unquote(substr(f[j], e + 1))
			}
		} else if (instr == "FROM") {
			j = k + 1
			while (j <= n && f[j] ~ /^--/) j++
			stages++
			image[stages] = f[j]
			name[stages] = (toupper(f[j + 1]) == "AS") ? tolower(f[j + 2]) : ""
		}
	}
	END {
		if (stages == 0) exit 0
		i = stages
		ref = expand(image[i])
		for (j = i - 1; j >= 1; j--) {
			if (name[j] != "" && name[j] == tolower(ref)) ref = expand(image[j])
		}
		if (unresolved) exit 1
		if (tolower(ref) != "scratch") print ref
	}'
}

# security: the base image of a Dockerfile's final stage changed since the last
# version (a Renovate tag or digest update, usually), and the new one no
# longer has fixable HIGH/CRITICAL findings that the old one has. Nothing is
# built: both are public or registry images, scanned remotely. Sets
# SECURITY_NOTE to the list. A Dockerfile that cannot be read, resolved or
# scanned is skipped with a warning, never failing the run.
base_image_fixes_cves() {
	all_fixed=""
	for df in $(dockerfiles); do
		df=${df#./}
		git cat-file -e "HEAD:./$df" 2>/dev/null || continue
		if ! git cat-file -e "$1:./$df" 2>/dev/null; then
			log "$df is new since $1: no base image to compare"
			continue
		fi
		if ! old=$(git show "$1:./$df" | dockerfile_base) ||
			! new=$(git show "HEAD:./$df" | dockerfile_base); then
			log "warning: cannot resolve the base image of $df (an ARG without a default?); skipping it"
			continue
		fi
		if [ "$old" = "$new" ]; then
			log "Base image of $df unchanged since $1: ${new:-none}"
			continue
		fi
		log "Base image of $df: ${old:-none} in $1, ${new:-none} now"
		if [ -z "$old" ] || [ -z "$new" ]; then
			continue
		fi
		registry_login
		if ! released=$(image_vulns "$old"); then
			log "warning: cannot scan $old; skipping $df"
			continue
		fi
		if ! current=$(image_vulns "$new"); then
			log "warning: cannot scan $new; skipping $df"
			continue
		fi
		fixed=$(printf '%s\n' "$released" | grep -vxF -f "$(printf '%s\n' "$current" | tmpfile)" | grep . || true)
		log "Fixable HIGH/CRITICAL in $old: $(printf '%s' "$released" | grep -c . || true), in $new: $(printf '%s' "$current" | grep -c . || true)"
		[ -z "$fixed" ] || all_fixed=$(printf '%s\n%s' "$all_fixed" "$fixed")
	done
	[ -n "$all_fixed" ] || return 1
	SECURITY_NOTE=$(printf '%s\n' "$all_fixed" | grep . | sort -u | awk '{printf "- %s in `%s`\n", $1, $2}')
}

# AUTO_RELEASE_REBUILD_DAYS as a plain number; 7 when unset or empty.
rebuild_days() {
	d=${AUTO_RELEASE_REBUILD_DAYS:-7}
	case $d in *[!0-9]*) die "AUTO_RELEASE_REBUILD_DAYS must be a whole number of days, 0 to disable; got '$d'" ;; esac
	d=$(printf '%s' "$d" | sed 's/^0*//')
	printf '%s' "${d:-0}"
}

# When a tag was made: the tagger date of an annotated tag, which auto-release
# pushes, or the commit date of a lightweight one, which can only be earlier.
tag_time() {
	git for-each-ref --format='%(creatordate:unix)' "refs/tags/$1"
}

# The Dockerfile AUTO_RELEASE_IMAGE is built from: the only listed one that
# exists at the last tag. Fails, saying why, when several do, since the image
# cannot be matched to one of them; fails quietly when none does.
release_dockerfile() {
	found="" several=""
	for df in $(dockerfiles); do
		df=${df#./}
		git cat-file -e "$1:./$df" 2>/dev/null || continue
		[ -z "$found" ] || several=true
		found=$df
	done
	if [ -n "$several" ]; then
		log "Fresh rebuild check: several Dockerfiles but one AUTO_RELEASE_IMAGE, which cannot be matched to one of them; skipping"
		return 1
	fi
	[ -n "$found" ] || return 1
	printf '%s' "$found"
}

# Fresh rebuild: the image of the last release has fixable HIGH/CRITICAL
# findings in packages its Dockerfile installs (apk add, apt-get install
# without versions), which a build from scratch picks up once the distribution
# ships the fix, while nothing in the repository changes to trigger one. A
# finding counts when it is in an OS package of ${AUTO_RELEASE_IMAGE}:<last
# version> and not in the final-stage base image at the last tag, whose own
# fixes need a base image update instead. Language packages are left out:
# lock files and pinned versions keep them as they are, so a rebuild would
# not fix them. Only when the last tag is AUTO_RELEASE_REBUILD_DAYS old, so a
# fix that is not out yet costs one release per period, not one per run.
# Sets REBUILD_NOTE. Skips, never failing the run, when anything cannot be
# resolved or scanned.
rebuild_fixes_cves() {
	days=$(rebuild_days)
	[ "$days" -gt 0 ] || return 1
	df=$(release_dockerfile "$1") || return 1
	if [ -z "${AUTO_RELEASE_IMAGE:-}" ]; then
		log "Fresh rebuild check: no AUTO_RELEASE_IMAGE to scan; skipping"
		return 1
	fi
	age=$(($(date +%s) - $(tag_time "$1")))
	if [ "$age" -lt $((days * 86400)) ]; then
		log "Fresh rebuild check: $1 is $((age / 86400)) days old, under AUTO_RELEASE_REBUILD_DAYS=$days"
		return 1
	fi
	if ! base=$(git show "$1:./$df" | dockerfile_base); then
		log "warning: cannot resolve the base image of $df in $1 (an ARG without a default?); skipping the fresh rebuild check"
		return 1
	fi
	image="${AUTO_RELEASE_IMAGE}:${1#v}"
	registry_login
	if ! released=$(image_vulns "$image" os); then
		log "warning: cannot scan $image; skipping the fresh rebuild check"
		return 1
	fi
	from_base=""
	if [ -n "$base" ] && ! from_base=$(image_vulns "$base" os); then
		log "warning: cannot scan $base; skipping the fresh rebuild check"
		return 1
	fi
	added=$(printf '%s\n' "$released" | grep -vxF -f "$(printf '%s\n' "$from_base" | tmpfile)" | grep . || true)
	log "Fixable HIGH/CRITICAL in OS packages of $image: $(printf '%s' "$released" | grep -c . || true), of its base ${base:-scratch}: $(printf '%s' "$from_base" | grep -c . || true)"
	if [ -z "$added" ]; then
		log "Fresh rebuild check: none in the packages $df installs"
		return 1
	fi
	log "Fresh rebuild check: $1 is $((age / 86400)) days old and a rebuild should fix $(printf '%s\n' "$added" | grep -c .) findings"
	REBUILD_NOTE=$(printf '%s\n' "$added" | awk '{printf "- %s in `%s`\n", $1, $2}')
}

tmpfile() {
	f=$(mktemp)
	cat >"$f"
	printf '%s' "$f"
}

image_digest() {
	crane digest "$1" 2>/dev/null || true
}

registry_login() {
	[ -n "${REGISTRY_LOGIN:-}" ] || return 0
	registry=${REGISTRY_LOGIN% *} user=${REGISTRY_LOGIN#* }
	password=${REGISTRY_PASSWORD:-$FORGE_TOKEN}
	case ${AUTO_RELEASE_IMAGE:-} in "$registry"/*) ;; *) return 0 ;; esac
	[ -n "$password" ] || return 0
	printf '%s' "$password" | crane auth login "$registry" -u "$user" --password-stdin >/dev/null 2>&1 ||
		log "warning: could not log in to $registry; trying anonymously"
}

cliff_config() {
	if [ -n "${AUTO_RELEASE_CONFIG:-}" ]; then
		printf '%s' "$AUTO_RELEASE_CONFIG"
	elif [ -f cliff.toml ]; then
		printf cliff.toml
	else
		printf '%s/cliff.toml' "$SHARE_DIR"
	fi
}

cliff() {
	AUTO_RELEASE_COMMIT_URL=$COMMIT_URL NO_COLOR=1 GIT_CLIFF_OFFLINE=true \
		git-cliff --config "$(cliff_config)" --tag-pattern "$TAG_PATTERN" "$@"
}

# Sets NEEDED, NEXT_TAG, NOTES_FILE.
plan() {
	NEEDED=false NEXT_TAG="" DIGEST_NOTE="" SECURITY_NOTE="" REBUILD_NOTE=""
	rebuild_days >/dev/null
	LATEST_TAG=$(latest_tag)
	if [ -z "$LATEST_TAG" ]; then
		log "No vX.Y.Z tag found: push an initial tag by hand to bootstrap. Skipping."
		return 0
	fi
	log "Latest tag: $LATEST_TAG"
	version=${LATEST_TAG#v}
	count=$(git rev-list --count "${LATEST_TAG}..HEAD")
	log "Commits since $LATEST_TAG: $count"

	case $STRATEGY in
	commits)
		[ "$count" -gt 0 ] && NEEDED=true
		if rebuild_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		;;
	conventional)
		if [ "$count" -gt 0 ] && has_releasable_commits "$LATEST_TAG"; then
			NEEDED=true
		elif [ "$count" -gt 0 ]; then
			log "No feat/fix/perf/revert or breaking commit since $LATEST_TAG."
		fi
		# The weekly run is what catches a fix the distribution shipped
		# while the repository stood still.
		if rebuild_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		;;
	docker)
		[ -n "${AUTO_RELEASE_IMAGE:-}" ] || die "the docker strategy needs AUTO_RELEASE_IMAGE"
		registry_login
		tagged=$(image_digest "${AUTO_RELEASE_IMAGE}:${version}")
		latest=$(image_digest "${AUTO_RELEASE_IMAGE}:latest")
		log "Tagged (${version}) digest : ${tagged:-not found}"
		log "Latest              digest : ${latest:-not found}"
		# A missing version tag means the build that should have published it
		# failed, so latest already holds newer content.
		if [ -n "$latest" ] && [ "$tagged" != "$latest" ]; then
			NEEDED=true
			DIGEST_NOTE="Image digest changed: \`${latest}\`"
		fi
		;;
	security)
		# Runs on every push, outside the weekly rhythm: release at once only
		# for a CVE fix, either a Renovate fix(security) update, a base image
		# update that drops fixable HIGH/CRITICAL findings, or a fresh
		# rebuild that should drop them from the packages the image adds.
		if [ "$count" -gt 0 ] && has_security_commits "$LATEST_TAG"; then
			NEEDED=true
		fi
		if base_image_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		if rebuild_fixes_cves "$LATEST_TAG"; then
			NEEDED=true
		fi
		[ "$NEEDED" = true ] || log "No security fix since $LATEST_TAG."
		;;
	*) die "unknown strategy '$STRATEGY' (commits, conventional, docker or security)" ;;
	esac

	if [ "$NEEDED" != true ]; then
		log "No release needed."
		return 0
	fi

	# docker has no commit range to classify, so it always stays patch. For the
	# others git-cliff applies the Conventional Commit rules; when every commit
	# is one the config skips (merges, chore(release)) it reports no bump, and
	# a commit still landed, so release a patch.
	if [ "$STRATEGY" = docker ] || [ "$count" -eq 0 ]; then
		NEXT_TAG=$(bump "$version" patch)
	else
		NEXT_TAG=$(cliff --bumped-version)
		case $NEXT_TAG in v*) ;; *) NEXT_TAG=v$NEXT_TAG ;; esac
		if ! printf '%s' "$NEXT_TAG" | grep -qE "$TAG_PATTERN"; then
			die "git-cliff proposed '$NEXT_TAG', not a vX.Y.Z version"
		fi
		[ "$NEXT_TAG" = "$LATEST_TAG" ] && NEXT_TAG=$(bump "$version" patch)
	fi
	log "Next tag: $NEXT_TAG"

	NOTES_FILE=$(mktemp)
	{
		if [ -n "$SECURITY_NOTE$REBUILD_NOTE" ]; then
			printf '### Security fixes in the image\n\n'
		fi
		if [ -n "$SECURITY_NOTE" ]; then
			printf '%s\n\n' "$SECURITY_NOTE"
		fi
		if [ -n "$REBUILD_NOTE" ]; then
			printf 'A fresh build of the packages the image installs on top of its base image is expected to fix these findings of %s:\n\n%s\n\n' \
				"$LATEST_TAG" "$REBUILD_NOTE"
		fi
		if [ -n "$DIGEST_NOTE" ]; then
			printf '%s\n\n' "$DIGEST_NOTE"
		fi
		if [ -n "${AUTO_RELEASE_BASE_IMAGE_PATTERN:-}" ] && [ -f Dockerfile ]; then
			base=$(grep -E "$AUTO_RELEASE_BASE_IMAGE_PATTERN" Dockerfile || true)
			if [ -n "$base" ]; then
				# shellcheck disable=SC2016 # Markdown fence, not a command substitution
				printf 'Base image:\n```\n%s\n```\n\n' "$base"
			fi
		fi
		notes=$(cliff --unreleased --tag "$NEXT_TAG" --strip all)
		notes=$(printf '%s\n' "$notes" | sed -e '/./,$!d')
		if [ -n "$notes" ]; then
			printf '%s\n' "$notes"
		elif [ "$count" -eq 0 ]; then
			printf 'No commits since %s.\n' "$LATEST_TAG"
		else
			printf 'No notable changes since %s.\n' "$LATEST_TAG"
		fi
		if [ -n "$COMPARE_URL" ]; then
			printf '\n**Full changelog:** %s%s...%s\n' "$COMPARE_URL" "$LATEST_TAG" "$NEXT_TAG"
		fi
	} >"$NOTES_FILE"
}

report() {
	if [ -n "${GITHUB_OUTPUT:-}" ]; then
		{
			printf 'released=%s\n' "$1"
			printf 'tag=%s\n' "$NEXT_TAG"
		} >>"$GITHUB_OUTPUT"
	fi
	[ "$NEEDED" = true ] || return 0
	printf '## %s\n\n' "$NEXT_TAG"
	cat "$NOTES_FILE"
	if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
		{
			if [ "$1" = true ]; then printf '## Released %s\n\n' "$NEXT_TAG"; else printf '## Next release: %s (not tagged)\n\n' "$NEXT_TAG"; fi
			cat "$NOTES_FILE"
		} >>"$GITHUB_STEP_SUMMARY"
	fi
}

release() {
	[ -n "$FORGE_TOKEN" ] || die "no token: set AUTO_RELEASE_TOKEN (GitHub and Forgejo also take GITHUB_TOKEN)"
	# Annotated, so the tag records when it was made (the fresh rebuild
	# check counts days from it), and unsigned, whatever the runner's config
	# says. A job container often has no git identity: fall back to one.
	git var GIT_COMMITTER_IDENT >/dev/null 2>&1 ||
		set -- -c user.name=auto-release -c user.email=auto-release@localhost
	git "$@" -c tag.gpgSign=false -c tag.forceSignAnnotated=false tag -a -m "$NEXT_TAG" "$NEXT_TAG"
	if ! out=$(git push --quiet "$PUSH_URL" "refs/tags/${NEXT_TAG}" 2>&1); then
		printf '%s\n' "$out" | sed "s|${FORGE_TOKEN}|***|g" >&2
		die "pushing $NEXT_TAG failed"
	fi
	log "Pushed $NEXT_TAG"
	# The tag is out either way: start its build even if the Release failed,
	# then fail the job so the missing Release gets noticed.
	rc=0
	if forge_release "$NEXT_TAG" "$NOTES_FILE"; then
		log "Created the $FORGE Release for $NEXT_TAG"
	else
		log "auto-release: creating the Release for $NEXT_TAG failed"
		rc=1
	fi
	forge_dispatch "$NEXT_TAG" || rc=1
	return "$rc"
}

# A job container runs as root on a checkout owned by the runner's user, and
# actions/checkout records safe.directory only under a temporary HOME, so git
# and git-cliff (libgit2) refuse the repository as dubious ownership. In CI the
# checkout is the job's own: trust it, for this process only. libgit2 reads
# neither -c nor GIT_CONFIG_*, only the global file, hence a temporary HOME
# whose .gitconfig includes the real one.
trust_checkout() {
	global=${GIT_CONFIG_GLOBAL:-${HOME:-/nonexistent}/.gitconfig}
	home=$(mktemp -d)
	{
		if [ -f "$global" ]; then
			printf '[include]\n\tpath = %s\n' "$global"
		fi
		printf '[safe]\n\tdirectory = *\n\tdirectory = %s\n' "$(pwd -P)"
	} >"$home/.gitconfig"
	if [ -d "${HOME:-/nonexistent}/.docker" ]; then
		export DOCKER_CONFIG="${DOCKER_CONFIG:-$HOME/.docker}"
	fi
	export HOME="$home" GIT_CONFIG_GLOBAL="$home/.gitconfig"
}

on_tag_ref() {
	ON_TAG=${CI_COMMIT_TAG:-}
	case ${GITHUB_REF:-} in refs/tags/*) ON_TAG=${GITHUB_REF#refs/tags/} ;; esac
	[ -n "$ON_TAG" ]
}

main() {
	command=plan
	is_true "${AUTO_RELEASE_DRY_RUN:-}" || command=${1:-release}
	case ${1:-} in -h | --help | help) usage ;; esac
	case $command in plan | release) ;; *) log "unknown command '$command'"; usage 2 ;; esac

	STRATEGY=${AUTO_RELEASE_STRATEGY:-commits}
	FORGE=$(detect_forge)
	case $FORGE in github | gitlab | forgejo | none) ;; *) die "unknown forge '$FORGE'" ;; esac
	# A release run on a tag ref is the tag build it dispatched itself. With
	# the docker strategy its version image is not built yet, so it would tag
	# again, and again: docker-salt got 995 tags on one commit that way.
	if [ "$command" = release ] && on_tag_ref; then
		log "Running on tag ${ON_TAG}: releases are cut from branches. Skipping."
		return 0
	fi

	[ "$FORGE" = none ] || trust_checkout

	if ! err=$(git rev-parse --git-dir 2>&1 >/dev/null); then
		die "not inside a usable git repository: $err"
	fi
	if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
		die "shallow clone: fetch the full history (fetch-depth: 0 / GIT_DEPTH: 0)"
	fi
	"setup_$FORGE"
	# Tests push to a local bare repository instead.
	PUSH_URL=${AUTO_RELEASE_PUSH_URL:-$PUSH_URL}
	log "Forge: $FORGE, strategy: $STRATEGY"
	if [ "$command" = release ] && [ "$FORGE" = none ]; then
		die "no forge detected, so nothing to release to: run 'auto-release plan' or set AUTO_RELEASE_FORGE"
	fi

	if git remote get-url origin >/dev/null 2>&1; then
		git fetch --quiet --tags origin 2>/dev/null || log "warning: could not fetch tags; using the local ones"
	fi
	plan
	if [ "$command" = plan ] || [ "$NEEDED" != true ]; then
		report false
		return 0
	fi
	release_rc=0
	release || release_rc=$?
	report true
	return "$release_rc"
}

main "$@"
